    "@payloadcms/ui": "^3.90.2",
    "canvas-confetti": "^1.9.4",
    "cloudinary": "^2.11.0",
    "cross-env": "^10.1.0",
    "graphql": "^16.14.2",
    "lenis": "^1.3.26",
    "lucide-react": "^1.49.0",
    "motion": "^13.5.0",
    "next": "^16.3.8",
    "payload": "^3.90.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
