# Public site URL (used in emails + metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payments: "mock" until a real gateway is wired up in lib/payments.ts
PAYMENT_PROVIDER=mock
# Mock payments are blocked in production unless this is "true" (e.g. a client preview deploy)
ALLOW_MOCK_PAYMENTS=false
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Delivery email (https://resend.com). Without a key, emails are logged to the console.
RESEND_API_KEY=
EMAIL_FROM="Spreadsheet Dude <hello@yourdomain.com>"

# Meta (Instagram) Pixel for ad conversion tracking
NEXT_PUBLIC_META_PIXEL_ID=
