# ---- Required ----
# Long random string; keeps admin logins and download links secure.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Public site URL (used in emails and for admin login security)
NEXT_PUBLIC_SITE_URL=https://pandoratemplates.com

# ---- Database: MongoDB Atlas ----
# Atlas → your cluster → Connect → Drivers → copy the connection string, and add a database name
# before the "?", e.g. ...mongodb.net/pandora?retryWrites=true&w=majority
# Atlas → Network Access must allow Vercel to connect (0.0.0.0/0, or Vercel's IPs).
DATABASE_URI=

# ---- Image / video / file uploads: Cloudinary ----
# Cloudinary dashboard → "API Keys" / "Go to API Keys" → copy the "API environment variable".
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
# Leave empty locally to save uploads to ./media and ./product-files instead (won't work on Vercel).
CLOUDINARY_URL=

# ---- Payments: Razorpay ----
# Razorpay Dashboard → Account & Settings → API Keys. Test keys start with rzp_test_ (no real money),
# live keys with rzp_live_. With no keys, checkout runs in demo mode (blocked in production unless
# ALLOW_MOCK_PAYMENTS=true).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard → Webhooks → Add: URL https://<your-site>/api/payment/webhook,
# events payment.captured + order.paid, and a secret you make up (paste the same secret here).
RAZORPAY_WEBHOOK_SECRET=
ALLOW_MOCK_PAYMENTS=false

# ---- Email: Brevo (https://www.brevo.com) ----
# Brevo → (profile menu) SMTP & API → API keys → Generate a new API key.
# Without a key, emails are only logged to the server console.
BREVO_API_KEY=
# Sender shown to customers. Must be verified in Brevo → Senders, Domains & Dedicated IPs.
EMAIL_FROM_ADDRESS=pandoratemplate@gmail.com
EMAIL_FROM_NAME=Pandora Templates
# Where contact-form messages are emailed (defaults to EMAIL_FROM_ADDRESS). Always saved in the admin too.
CONTACT_TO_EMAIL=

# ---- Ads ----
# Optional fallback; the Meta Pixel ID is normally set in the admin under Site settings → Tracking.
NEXT_PUBLIC_META_PIXEL_ID=
