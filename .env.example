# ---- Required ----
# Long random string; keeps admin logins and download links secure.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Public site URL (used in emails and for admin login security)
NEXT_PUBLIC_SITE_URL=https://pandoratemplates.com

# ---- Database ----
# Leave empty locally (uses ./payload.db). In production use Turso (Vercel Marketplace → Turso):
# DATABASE_URI=libsql://your-db-name.turso.io
# DATABASE_AUTH_TOKEN=
DATABASE_URI=
DATABASE_AUTH_TOKEN=

# ---- Image / file uploads ----
# Vercel Blob (Vercel → Storage → Blob). Leave empty locally (files are saved to ./media and ./product-files).
BLOB_READ_WRITE_TOKEN=

# ---- Payments ----
# "mock" until a real gateway is connected in lib/payments.ts
PAYMENT_PROVIDER=mock
# Mock payments are refused in production unless this is "true" (e.g. a client demo)
ALLOW_MOCK_PAYMENTS=false
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# ---- Email (https://resend.com) ----
# Without a key, emails are only logged to the server console.
RESEND_API_KEY=
EMAIL_FROM="Pandora Templates <hello@pandoratemplates.com>"
# Plain address used for admin emails such as "forgot password"
EMAIL_FROM_ADDRESS=hello@pandoratemplates.com
# Where contact-form messages are emailed (they're always saved in the admin too)
CONTACT_TO_EMAIL=

# ---- Ads ----
# Optional fallback; the Meta Pixel ID is normally set in the admin under Site settings → Tracking.
NEXT_PUBLIC_META_PIXEL_ID=
